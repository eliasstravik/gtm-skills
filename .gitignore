# Raw evaluation executions; curated evidence belongs in evals/<name>/evidence/.
evals/*/runs/

# Local Superpowers planning artifacts do not belong in this repository.
docs/superpowers/

# Local Paperclip execution worktrees and runtime state.
.paperclip/

# Local agent skill symlinks (.agents/skills -> ../skills, .claude/skills ->
# ../.agents/skills) created per-worktree by the execution-workspace
# provision command so agents load the checkout's skills project-level.
.agents/
.claude/

# Per-run description transcripts.
evals/*/description/**/transcripts/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Runtime artifacts a local build or check leaves inside the copied-in template.
skills/gtm-workflow/templates/.env
skills/gtm-workflow/templates/.env.turso
skills/gtm-workflow/templates/.output/
skills/gtm-workflow/templates/.nitro/
skills/gtm-workflow/templates/.swc/
skills/gtm-workflow/templates/.workflow-data/
skills/gtm-workflow/templates/.gtm-local.json
skills/gtm-workflow/templates/data/
