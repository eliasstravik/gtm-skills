# Also used as CRON_SECRET on Vercel.
GTM_RUN_SECRET=

# Optional webhook that receives completed workflow results.
GTM_RESULTS_URL=

# Optional: claude | codex | cursor | gemini | opencode | api
GTM_AGENT_BACKEND=

# Provider/model string for the api backend. Defaults to anthropic/claude-opus-5.
GTM_AGENT_MODEL=

# Vercel AI Gateway key with a spending budget. Used by the api backend here and on Vercel.
AI_GATEWAY_API_KEY=
