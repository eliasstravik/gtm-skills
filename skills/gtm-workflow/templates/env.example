GTM_RUN_SECRET=
CRON_SECRET=
GTM_MODEL=openai/gpt-5.6-luna
# Optional: reasoning effort for AI steps and agent stages (none, minimal, low, medium, high, xhigh); the provider's default when unset
GTM_REASONING=
# Optional, this computer only: AI Gateway key for AI steps when this checkout is not linked to a Vercel project (vercel link).
# On Vercel the deployed copy uses the project's own identity (OIDC) and needs no key.
AI_GATEWAY_API_KEY=
# Optional, this computer only: run agent stages on your Claude Code or Codex subscription (claude or codex); unset means AI Gateway.
# A stage that uses custom tools, approvals, streaming, or messages runs on the Gateway regardless; the hosted copy always does.
GTM_AGENT_BACKEND=
# Optional: so runs can reach people in Slack through the GTM agent (both values also live on the agent project)
GTM_AGENT_URL=
GTM_NOTIFY_SECRET=
# Once a project is connected: its production URL; hosted data is read through its query route with GTM_RUN_SECRET
GTM_WORKFLOW_URL=
# DATABASE_URL and DATABASE_URL_UNPOOLED are set on the Vercel project by the Neon integration only; never put them here.
# Locally the launcher starts this workspace's own Postgres and ignores any database variable in this file.
# GTM_RUNS_URL and GTM_DATA_URL (the hosted Runs and Data pages) are Vercel project variables too; locally the links are built in
# Viewer owner destinations. Configure hosted values on the private workflow project.
# GTM_VIEWER_REPOSITORY=owner/repository
# GTM_VIEWER_REPOSITORY_ROOT=workflows
# GTM_VIEWER_VERCEL_RUNS_URL=https://vercel.com/team/project/workflows/runs?environment=production
# GTM_VIEWER_DATABASE_URL=https://console.neon.tech/app/projects/...
# Local tools must point to this workspace's local data and run store.
# GTM_VIEWER_DRIZZLE_URL=https://local.drizzle.studio
# GTM_VIEWER_INSPECTOR_URL=http://localhost:3001
# GTM_VIEWER_INSPECTOR_STORE=local
# GTM_VIEWER_LINK_KEY is a private-project-only 32-byte hex secret. Never save it here.
# Back it up in the secret manager before enabling sharing; see references/viewer.md.
