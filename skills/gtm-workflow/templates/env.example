GTM_RUN_SECRET=
CRON_SECRET=
GTM_MODEL=openai/gpt-5.6-luna
# Optional: reasoning effort for AI steps and agent stages (none, minimal, low, medium, high, xhigh); the provider's default when unset
GTM_REASONING=
# Optional: only AI steps that use AI Gateway (generateObject or runAgent) need it
AI_GATEWAY_API_KEY=
# Optional: agent stages with web search on need it; page fetch is free and needs no key
EXA_API_KEY=
# Once a project is connected: its production URL, and read-only access to the hosted database (TURSO_STUDIO_URL is the https:// form)
GTM_WORKFLOW_URL=
TURSO_STUDIO_URL=
TURSO_STUDIO_TOKEN=
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are Vercel project variables only; never put them here
# GTM_RUNS_URL and GTM_DATA_URL (the hosted Runs and Data pages) are Vercel project variables too; locally the links are built in
