{
  "name": "gtm-workflows",
  "version": "0.1.40",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/build-viewer.mjs && drizzle-kit migrate && node scripts/profile-migrate.mjs && node scripts/viewer-migrate.mjs && WORKFLOW_LOCAL_HEADERS_TIMEOUT_MS=900000 WORKFLOW_LOCAL_BODY_TIMEOUT_MS=900000 nitro dev --port 3939",
    "build": "node scripts/build-viewer.mjs && drizzle-kit migrate && node scripts/profile-migrate.mjs && node scripts/viewer-migrate.mjs && nitro build",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "viewer": "node scripts/start-viewer.mjs",
    "viewer:register": "node scripts/viewer-registry.mjs",
    "build:share": "node scripts/build-share.mjs && GTM_VIEWER_MODE=share nitro build"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.80",
    "@ai-sdk/mcp": "2.0.49",
    "@ai-sdk/openai": "4.0.66",
    "@ai-sdk/workflow": "2.0.30",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@libsql/client": "0.18.0",
    "@vercel/oidc": "3.8.7",
    "@xyflow/react": "12.11.6",
    "ai": "7.0.99",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.2",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workflow": "5.0.0-beta.51",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
