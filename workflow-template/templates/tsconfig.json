{
  "extends": "nitro/tsconfig",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "#viewer-registry": [
        "./node_modules/.gtm-viewer/registry.json"
      ],
      "#viewer-groups": [
        "./node_modules/.gtm-viewer/groups.json"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".output",
    ".nitro"
  ]
}
